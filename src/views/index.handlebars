<main class="contenedor">

    <!-- CUADRO 1: fijo -->
    <div class="banner">PUBLICIDAD</div>

    <!-- CUADRO 2: variable -->
    <h2 class="usuario">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="7" r="5"></circle>
            <path d="M2 23c0-5.5 4.5-9 10-9s10 3.5 10 9z"></path>
        </svg>
        USERNAME: {{username}}
    </h2>

    <!-- Formulario -->
    <form class="formulario" action="/mensaje" method="POST">
        <label for="mensaje">MENSAJE:</label>
        <input type="hidden" name="username" value="{{username}}">
        <input type="text" id="mensaje" name="mensaje" placeholder="Escribe un mensaje..." required>
        <button type="submit">ENVIAR</button>
    </form>

    <!-- CUADRO 3: variable -->
    <section class="mensajes">
        {{#if hayMensajes}}
            {{#each mensajes}}
                <p><span class="autor">{{this.username}}</span> <span class="hora">({{this.hora}}):</span> {{this.mensaje}}</p>
            {{/each}}
        {{else}}
            <p class="vacio">Aún no hay mensajes</p>
        {{/if}}
    </section>

</main>
